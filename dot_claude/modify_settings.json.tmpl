#!/bin/bash
set -euo pipefail

# Managed Claude Code settings (merges with existing file, preserving unmanaged keys like hooks)
managed='
{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SHELL": "/bin/zsh"
  },
  "attribution": {
    "pr": ""
  },
  "statusLine": {
    "type": "command",
    "command": "~/Code/_forks/starship-claude/plugin/bin/starship-claude"
  },
  "enabledPlugins": {
{{- range $i, $p := .claude_plugins }}
    "{{ $p.name }}@{{ $p.marketplace }}": true{{ if not (eq $i (sub (len $.claude_plugins) 1)) }},{{ end }}
{{- end }}
  },
  "effortLevel": "high"
}
'

# Array entries added to whatever the live file already holds (deep merge replaces arrays)
managed_arrays='
{
  "permissions": {
    "additionalDirectories": ["~/Code/personal-wiki"],
    "allow": ["Read(~/Code/personal-wiki/**)", "Edit(~/Code/personal-wiki/**)"]
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": ["{{ .chezmoi.homeDir }}/Code/personal-wiki"]
    }
  }
}
'

# Read current file from stdin; deep-merge managed keys so unmanaged ones survive,
# including machine-local entries inside env and enabledPlugins
current="$(cat)"
[ -n "$current" ] || current='{}'
echo "$current" | jq --argjson managed "$managed" --argjson arrays "$managed_arrays" '
  def union($path): (getpath($path) // []) as $have
    | setpath($path; $have + [($arrays | getpath($path))[] | select(. as $x | $have | index([$x]) | not)]);
  (. * $managed)
  | union(["permissions", "additionalDirectories"])
  | union(["permissions", "allow"])
  | union(["sandbox", "filesystem", "allowWrite"])
'
